# Copy to .env to change anything. Every value here has a working default,
# so the service runs correctly with no .env file at all.

# --- service ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
TICK_SECONDS=2.6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sushanthbhatp2005.github.io

# --- stores ----------------------------------------------------------------
# Leave blank to use the in-process implementation. Uncomment after
# `docker compose up -d` to use the real stack.
# TIMESCALE_DSN=postgresql://visionx:visionx@localhost:5432/visionx
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=visionx123
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0

# --- NLP -------------------------------------------------------------------
# auto   : use transformers if installed, else the rule annotator  (default)
# rules  : always rule-based -- instant start, no downloads
# models : require transformers
NLP_BACKEND=auto
NLP_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
NLP_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
NLP_DEVICE=cpu

# --- ingestion -------------------------------------------------------------
# Off by default so the demo is deterministic. POST /api/ingest/run pulls once
# on demand; set true to poll on a timer.
INGEST_ENABLED=false
INGEST_INTERVAL_SECONDS=300
INGEST_SUBREDDITS=bangalore,india,karnataka
INGEST_RSS_FEEDS=https://feeds.feedburner.com/ndtvnews-india-news,https://www.thehindu.com/news/national/karnataka/feeder/default.rss

# Reddit and RSS need no credentials and work out of the box.
# These two do; without them those collectors report themselves unavailable.
# YOUTUBE_API_KEY=
# X_BEARER_TOKEN=
